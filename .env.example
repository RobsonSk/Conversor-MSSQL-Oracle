# MSSQL Configuration
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=source_database
MSSQL_USER=sa
MSSQL_PASSWORD=YourPassword123!

# Oracle Configuration
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_CONNECTION_STRING=localhost:1521/ORCL

# Migration Configuration
MIGRATION_MODE=full
# Options: full, incremental, test, resume
# full: Carga inicial completa com Streaming de alta velocidade e Bulk
# incremental: Sincronização inteligente apenas do que mudou ou é novo (Delta / MERGE)
# test: Teste em uma tabela específica (requer TARGET_TABLE)
# resume: Continua do último checkpoint

# For test mode, specify the table name
TARGET_TABLE=

# Migration Settings
BATCH_SIZE=25000
MAX_RETRIES=3
DISABLE_CONSTRAINTS=true
DISABLE_INDEXES=true
AUTO_RESUME=true
USE_TRUNCATE=true
AUTO_ADD_COLUMNS=true
VALIDATE_DATA_TYPES=false
LOG_ERRORS=true
FAST_RELOAD_THRESHOLD=50000
INCREMENTAL_LOOKBACK_MINUTES=30

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/migration.log
LOG_MAX_SIZE=100m
LOG_MAX_FILES=10

# Performance
CONNECTION_POOL_MIN=5
CONNECTION_POOL_MAX=20
QUERY_TIMEOUT=300000
