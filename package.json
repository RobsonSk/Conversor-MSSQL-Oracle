{
  "name": "conversor-mssql-oracle",
  "version": "1.0.0",
  "description": "Node.js application to migrate data from MSSQL to Oracle database",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "migrate:full": "ts-node src/index.ts --mode full",
    "migrate:incremental": "ts-node src/index.ts --mode incremental",
    "migrate:test": "ts-node src/index.ts --mode test",
    "migrate:resume": "ts-node src/index.ts --mode resume",
    "migrate:create-ddl": "ts-node src/scripts/create-ddl.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "node -e \"const fs = require('fs'); ['logs', 'log', 'fixes', 'dist'].forEach(d => { if (fs.existsSync(d)) { try { fs.readdirSync(d).forEach(f => fs.rmSync(require('path').join(d, f), { recursive: true, force: true })); } catch(e){} } });\"",
    "analyze-errors": "ts-node src/scripts/analyze-errors.ts",
    "retry-pending": "ts-node src/scripts/reinsert-pending.ts"
  },
  "keywords": [
    "mssql",
    "oracle",
    "database",
    "migration",
    "data-conversion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "mssql": "^9.1.1",
    "oracledb": "^6.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.10.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
